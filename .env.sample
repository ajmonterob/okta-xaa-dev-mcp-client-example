# Identity Provider (single login for all servers)
IDP_URL=https://idp.xaa.dev
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Web server
PORT=3333
# Full public URL of the OAuth callback — change to your ngrok/EC2 URL for remote access
CALLBACK_URL=http://localhost:3333/callback
# Random string used to sign session cookies — change in production
SESSION_SECRET=change-this-to-a-random-string

# MCP Server 1
MCP_SERVER_1_ENABLED=true
MCP_SERVER_1_NAME=QRTY MCP Server
MCP_SERVER_1_URL=https://mcp.qrty.page
MCP_SERVER_1_AUTH_URL=https://auth.resource.xaa.dev
MCP_SERVER_1_AUDIENCE=https://mcp.qrty.page/mcp
MCP_SERVER_1_SCOPES=mcp.access

# MCP Server 2
MCP_SERVER_2_ENABLED=true
MCP_SERVER_2_NAME=Todo0 MCP Server
MCP_SERVER_2_URL=https://mcp.xaa.dev
MCP_SERVER_2_AUTH_URL=https://auth.resource.xaa.dev
MCP_SERVER_2_AUDIENCE=https://mcp.xaa.dev/mcp
MCP_SERVER_2_SCOPES=todos.read,mcp.access

# Anthropic (for Claude chat)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
